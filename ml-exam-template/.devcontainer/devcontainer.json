{
  "name": "ML Exam — Linear & Logistic Regression",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/app/.venv/bin/python",
        "jupyter.notebookFileRoot": "${workspaceFolder}",
        "jupyter.kernels.filter": [],
        "files.exclude": {
          "**/__pycache__": true,
          "**/.ipynb_checkpoints": true
        }
      }
    }
  },
  "forwardPorts": [],
  "postCreateCommand": "/app/.venv/bin/python -m ipykernel install --user --name=ml-exam --display-name 'Python (ml-exam)' && echo '✅ Entorno listo. Abre notebooks/exam.ipynb para comenzar.'",
  "remoteUser": "root"
}